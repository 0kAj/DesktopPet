<engine:Window x:Class="DesktopPet.WPF.GameSelectorWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:engine="clr-namespace:DesktopPet.Engine"
               xmlns:ui="clr-namespace:DesktopPet.WPF.GameWindows.customControls.UI"
               xmlns:fa="http://schemas.fontawesome.io/icons/"
               xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
               mc:Ignorable="d"
               AllowsTransparency="True"
               Background="Transparent"
               WindowStyle="None"
               Topmost="False"
               Icon="pack://application:,,,/Assets/Sprites/Pets/Mouse.png"
               WindowStartupLocation="CenterScreen"
               Title="{ Binding Title }" Height="450" Width="800">

    <engine:Window.Resources>
        <ResourceDictionary Source="/WPF/ResourceDictionaries/DesktopPetTheme.xaml" />
    </engine:Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header für Close Button -->
                    <RowDefinition Height="*" />    <!-- Hauptinhalt -->
                </Grid.RowDefinitions>

                <!-- Header mit Close Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Game Selector"
                               Style="{StaticResource HeaderTextBlock}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />

                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource CloseButton}"
                            Command="{ Binding CloseCommand }" />
                </Grid>

                <!-- Hauptinhalt: Game Selection & Pet Panel -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game Selection -->
                    <ScrollViewer Grid.Column="0" 
                                  MaxWidth="1110" Width="700"
                                  MaxHeight="750" Height="750">
                        <WrapPanel Margin="20" ScrollViewer.CanContentScroll="True"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <!-- Food Collector Card -->
                            <Button Margin="5" Width="200" Height="200" Background="Beige"
                                    Command="{ Binding FoodCollectorCommand }">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/Sprites/Games/FoodCollector.png"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Height="140" Stretch="Uniform">
                                        <Image.Effect>
                                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="Food Collector"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontWeight="Bold"
                                               FontSize="20"
                                               Margin="5 0 5 0" />
                                </StackPanel>
                            </Button>
                            <!-- Pet Jump Card -->
                            <Button Margin="5" Width="200" Height="200" Background="Beige"
                                    Command="{ Binding PetJumpCommand }">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/Sprites/Games/PetJump.png"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Height="140" Stretch="Uniform">
                                        <Image.Effect>
                                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="Pet Jump"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontWeight="Bold"
                                               FontSize="20"
                                               Margin="5 0 5 0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="5" Width="200" Height="200" Background="Beige" IsEnabled="False">
                                <StackPanel>
                                    <!-- <Image Source="pack://application:,,,/Assets/Sprites/Games/PetJump.png" -->
                                    <!--        RenderOptions.BitmapScalingMode="NearestNeighbor" -->
                                    <!--        Height="140" Stretch="Uniform"> -->
                                    <!--     <Image.Effect> -->
                                    <!--         <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" /> -->
                                    <!--     </Image.Effect> -->
                                    <!-- </Image> -->
                                    <TextBlock Text="coming soon..."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               FontWeight="Bold"
                                               FontSize="20"
                                               Margin="5 0 5 0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- Pet Info Panel -->
                    <DockPanel Grid.Column="1" Margin="10">
                        <ui:CollectablesDisplay
                            Food="{ Binding CollectedFoodAttribute.Value, Converter={StaticResource StrToInt} }"
                            Thirst="{ Binding CollectedThirstAttribute.Value, Converter={StaticResource StrToInt} }"
                            Size="30"
                            DockPanel.Dock="Top" />
                        <Button Height="40" Width="40" DockPanel.Dock="Top" HorizontalAlignment="Right"
                                Background="Transparent" Command="{Binding ColorPickerCommand}">
                            <fa:ImageAwesome Icon="Eyedropper" />
                        </Button>
                        <StackPanel
                            Visibility="{Binding ShowColorPickers, Converter={StaticResource BoolToVisibilityConverter}}"
                            DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Right" Margin="20 0 20 0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Primary Color" HorizontalAlignment="Center" />
                                </StackPanel>
                                <colorpicker:SquarePicker x:Name="PrimaryColorPickerRing"
                                                          SelectedColor="{ Binding PrimaryColorAttribute.Value,Converter={StaticResource StrToColor},Mode=TwoWay }"
                                                          Width="40" Height="40" />
                                <StackPanel Orientation="Horizontal">
                                    <colorpicker:HexColorTextBox
                                        SelectedColor="{ Binding ElementName=PrimaryColorPickerRing, Path=SelectedColor, Mode=TwoWay }"
                                        ShowAlpha="False" Height="40" />
                                    <Button Margin="5 0 0 0" VerticalAlignment="Center" Command="{Binding ResetPrimaryColorCommand}">
                                        <fa:ImageAwesome Width="20" Height="20" Icon="RotateLeft"></fa:ImageAwesome>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Margin="20 0 20 0">
                                <TextBlock Text="Secondary Color" HorizontalAlignment="Center" />
                                <colorpicker:SquarePicker x:Name="SecondaryColorPickerRing"
                                                          SelectedColor="{ Binding SecondaryColorAttribute.Value,Converter={StaticResource StrToColor},Mode=TwoWay }"
                                                          Width="40" Height="40" />
                                <StackPanel Orientation="Horizontal">
                                    <colorpicker:HexColorTextBox
                                        SelectedColor="{ Binding ElementName=SecondaryColorPickerRing, Path=SelectedColor, Mode=TwoWay }"
                                        ShowAlpha="False" Height="40" />
                                    <Button Margin="5 0 0 0" VerticalAlignment="Center" Command="{Binding ResetSecondaryColorCommand}">
                                        <fa:ImageAwesome Width="20" Height="20" Icon="RotateLeft"></fa:ImageAwesome>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    Margin="20">

                            <!-- Pet Name -->
                            <TextBlock Text="{ Binding PetName }"
                                       Style="{StaticResource HeaderTextBlock}"
                                       Margin="10" />

                            <!-- Pet Image -->
                            <Grid RenderOptions.BitmapScalingMode="NearestNeighbor"
                                  Height="90"
                                  Width="90">
                                <Rectangle Width="90" Height="90"
                                           Fill="{ Binding PrimaryColorAttribute.Value,Converter={StaticResource StrToColorBrush} }">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                                    </Rectangle.Effect>
                                </Rectangle>
                                <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Height="90"
                                       Width="90"
                                       Source="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha.png" />
                                <Rectangle Width="90" Height="90" Fill="{ Binding SecondaryColorAttribute.Value,Converter={StaticResource StrToColorBrush} }">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_mouth.png"></ImageBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <!-- Hunger & Thirst Bars -->
                            <Border Background="{StaticResource TextBoxBackgroundBrush}"
                                    CornerRadius="8"
                                    Margin="10" Padding="10">
                                <StackPanel>
                                    <Label HorizontalAlignment="Center" Padding="0" FontSize="20" FontWeight="Bold"
                                           Foreground="#ac3133">
                                        Hunger
                                    </Label>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
                                        <Image Margin="0 0 5 0"
                                               Height="50" Width="50"
                                               Source="pack://application:,,,/Assets/Sprites/Food/apple.png"
                                               VerticalAlignment="Center" />
                                        <Grid Height="30"
                                              Width="250">
                                            <ProgressBar Foreground="#ac3133"
                                                         Background="BurlyWood"
                                                         Value="{ Binding Path=PetHungerAttribute.Value, Converter={StaticResource StrToDouble} }" />
                                            <Rectangle Width="250" Height="15" Fill="Black" Opacity="0.25"
                                                       VerticalAlignment="Bottom" />
                                        </Grid>
                                    </StackPanel>

                                    <Label HorizontalAlignment="Center" Padding="0" FontSize="20" FontWeight="Bold"
                                           Foreground="#3a416d">
                                        Thirst
                                    </Label>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
                                        <Image Margin="0 0 5 0"
                                               Height="50" Width="50"
                                               Source="pack://application:,,,/Assets/Sprites/Food/Waterbottle.png"
                                               VerticalAlignment="Center" />
                                        <Grid Height="30"
                                              Width="250">
                                            <ProgressBar Foreground="#3a416d"
                                                         Background="BurlyWood"
                                                         Value="{ Binding Path=PetThirstAttribute.Value, Converter={StaticResource StrToDouble} }" />
                                            <Rectangle Width="250" Height="15" Fill="Black" Opacity="0.25"
                                                       VerticalAlignment="Bottom" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                        <Button Command="{ Binding FeedCommand }"
                                                Style="{StaticResource AccentButtonAqua}"
                                                Margin="5">
                                            Feed
                                        </Button>
                                        <Button Command="{ Binding ThirstCommand }"
                                                Style="{StaticResource AccentButtonAqua}"
                                                Margin="5">
                                            Thirst
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Border.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>

</engine:Window>