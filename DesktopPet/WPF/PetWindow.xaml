<Window x:Class="DesktopPet.WPF.PetWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       mc:Ignorable="d"
                       Icon="pack://application:,,,/Assets/Sprites/Pets/Mouse.png"
                       WindowStyle="None"
                       AllowsTransparency="True"
                       Background="Transparent"
                       Topmost="True"
                       WindowState="Normal"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       Top="{Binding Top, Mode=TwoWay}"
                       Left="{Binding Left, Mode=TwoWay}"
                       Height="{Binding WindowHeight, Mode=TwoWay}"
                       Width="{Binding WindowWidth, Mode=TwoWay}"
                       d:DesignHeight="100" d:DesignWidth="150"
                       Title="PetWindow">
    <Window.Resources>
        <ResourceDictionary Source="/WPF/ResourceDictionaries/DesktopPetTheme.xaml" />
    </Window.Resources>
    <DockPanel HorizontalAlignment="Center">
        <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Foreground="Beige" x:Name="DebugLabel" Content="{Binding PetName}"></Label>
        <Grid x:Name="Pet"
              RenderOptions.BitmapScalingMode="NearestNeighbor"
              DockPanel.Dock="Bottom"
              VerticalAlignment="Bottom"
              ContextMenu="{Binding PetContextMenu}"
              d:DesignHeight="50" d:DesignWidth="50"
              Height="{Binding ObjectHeight}"
              Width="{Binding ObjectWidth}">
            <Rectangle Fill="{ Binding PrimaryColorAttribute.Value,Converter={StaticResource StrToColorBrush} }" />
            <Rectangle Fill="{ Binding SecondaryColorAttribute.Value,Converter={StaticResource StrToColorBrush} }">
                <Rectangle.OpacityMask>
                    <ImageBrush x:Name="PetOuterEyesOutline"
                                ImageSource="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_outer_eyes.png" />
                </Rectangle.OpacityMask>
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="{ Binding LookDirectionX }"
                                            Y="{ Binding LookDirectionY }" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Image x:Name="PetOuterEyes" Source="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_outer_eyes.png">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="{ Binding LookDirectionX }"
                                            Y="{ Binding LookDirectionY }" />
                        <ScaleTransform CenterY="20" ScaleY="{ Binding EyeScaleY }" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="PetInnerEyes" Source="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_inner_eyes.png">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="{ Binding LookDirectionX, Converter={ StaticResource ScaleConverter } }"
                                            Y="{ Binding LookDirectionY, Converter={ StaticResource ScaleConverter } }" />
                        <ScaleTransform CenterY="20" ScaleY="{ Binding EyeScaleY }" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Rectangle x:Name="PetNose" Fill="#ac3232">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_nose.png" />
                </Rectangle.OpacityMask>
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="{ Binding LookDirectionX }" Y="0" />
                        <ScaleTransform CenterY="35" ScaleY="1" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="PetMouth"
                       Fill="{ Binding SecondaryColorAttribute.Value,Converter={StaticResource StrToColorBrush} }">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/Sprites/Pets/Mouse_alpha_mouth.png" />
                </Rectangle.OpacityMask>
                <Rectangle.RenderTransform>
                    <TranslateTransform X="{ Binding LookDirectionX }" Y="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </DockPanel>
</Window>