<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Assets\Sprites\"/>
        <Folder Include="exceptions\"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\Sprites\DogFront2.png"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\Sprites\Pets\Mouse.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse.png"/>
        <None Remove="Assets\Sprites\Food\apple.png"/>
        <Resource Include="Assets\Sprites\Food\apple.png"/>
        <None Remove="Assets\Sprites\Food\WaterBottle.png"/>
        <Resource Include="Assets\Sprites\Food\WaterBottle.png"/>
        <None Remove="Assets\Sprites\Games\FoodCollector.png"/>
        <Resource Include="Assets\Sprites\Games\FoodCollector.png"/>
        <None Remove="Assets\Sprites\Games\PetJump.png"/>
        <Resource Include="Assets\Sprites\Games\PetJump.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha_eyes.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha_eyes.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha_mouth.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha_mouth.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha_nose.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha_nose.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha_inner_eyes.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha_inner_eyes.png"/>
        <None Remove="Assets\Sprites\Pets\Mouse_alpha_outer_eyes.png"/>
        <Resource Include="Assets\Sprites\Pets\Mouse_alpha_outer_eyes.png"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ColorHelper" Version="1.8.1"/>
        <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageReference Include="FontAwesome.WPF" Version="4.7.0.9"/>
        <PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2"/>
        <PackageReference Include="ValueConverters" Version="3.1.22"/>
    </ItemGroup>

    <ItemGroup>
        <Page Update="UI\GameWindows\FoodCollectorMiniGameWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\GameWindows\PetJumpMiniGameWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\ResourceDictionaries\MiniGameResources.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\GameWindows\customControls\UI\CollectablesDisplay.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\GameWindows\customControls\UI\TimerDisplay.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\GameWindows\customControls\UI\PauseMenu.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

</Project>
