<Window x:Class="DesktopPet.UI.RewardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopPet.UI"
        xmlns:customControls="clr-namespace:DesktopPet.UI.GameWindows.customControls"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Title="RewardsWindow" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary Source="/UI/ResourceDictionaries/DesktopPetTheme.xaml"/>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game over"
                               Style="{ StaticResource HeaderTextBlock}" />
                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource CloseButton}"
                            Click="CloseWindow" />
                </Grid>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FocusManager.FocusedElement="{ Binding ElementName=name_tb}"
                            Width="350">
                    <TextBlock Text="You collected:"
                               Margin="0 5 0 5"
                               Style="{StaticResource LabelTextBlock}" />
                    <Border Background="{StaticResource TextBoxBackgroundBrush}"
                            CornerRadius="8"
                            Padding="10"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                        </Border.Effect>
                        <customControls:CollectablesDisplay x:Name="CDisplay"/>
                    </Border>
                    
                    <Button Content="OK"
                            Margin="0 10 0 0"
                            Style="{StaticResource AccentButtonAqua}"
                            Background="Aqua" Foreground="DarkBlue"
                            IsDefault="True"
                            Click="CloseWindow">
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</Window>
