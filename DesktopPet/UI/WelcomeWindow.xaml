<Window x:Class="DesktopPet.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopPet.UI"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="WelcomeWindow" Height="450" Width="800">
    <Viewbox Stretch="Uniform">
        <Border BorderBrush="DarkBlue" BorderThickness="5" CornerRadius="50" Padding="20" Margin="40"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Welcome to your Desktop-Pet!"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="DarkBlue"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 25">
                    </TextBlock>
                    <Button Grid.Column="3" Content="✕"
                            Width="30" Height="30"
                            FontSize="20"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="DarkBlue"
                            BorderThickness="0" FontWeight="Bold"
                            Click="CloseButton_OnClick" />
                </Grid>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="350">
                    <TextBlock Text="What is the name of your pet?"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0 0 0 10"
                               Foreground="DarkSlateGray">
                    </TextBlock>
                    <Border Background="Wheat"
                            CornerRadius="8"
                            Padding="10"
                            BorderBrush="Wheat"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2"></DropShadowEffect>
                        </Border.Effect>
                        <TextBox Background="Wheat" x:Name="name_tb" FontSize="16" BorderThickness="0" />
                    </Border>
                    
                    <CheckBox x:Name="setAsDefaultPet_cb" Margin="15"
                              HorizontalAlignment="Center"
                              IsChecked="True"
                              VerticalAlignment="Center">Set as Default Pet</CheckBox>
                    
                    <Button Grid.Row="2" Content="Let's pet!" Width="150" Height="40"
                            HorizontalAlignment="Center" Margin="0 25 0 0"
                            Background="Aqua" Foreground="DarkBlue" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="OKButton_OnClick">
                        <Button.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</Window>