<engine:Window x:Class="DesktopPet.UI.WelcomeWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:engine="clr-namespace:DesktopPet.Engine"
               mc:Ignorable="d"
               Icon="pack://application:,,,/Assets/Sprites/Pets/Mouse.png"
               AllowsTransparency="True"
               Background="Transparent"
               WindowStyle="None"
               Topmost="True"
               WindowStartupLocation="CenterScreen"
               Title="WelcomeWindow" Height="450" Width="800">
    <engine:Window.Resources>
        <ResourceDictionary Source="/UI/ResourceDictionaries/DesktopPetTheme.xaml" />
    </engine:Window.Resources>
    <Viewbox Stretch="Uniform">
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Welcome to your Desktop-Pet!"
                               Style="{ StaticResource HeaderTextBlock}" />
                    <Button Grid.Column="2" Content="✕"
                            Style="{StaticResource CloseButton}"
                            Click="CloseButton_OnClick" />
                </Grid>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FocusManager.FocusedElement="{ Binding ElementName=NameTb}"
                            Width="350">
                    <TextBlock Text="What is the name of your pet?"
                               Margin="0 5 0 5"
                               Style="{StaticResource LabelTextBlock}" />
                    <Border Background="{StaticResource TextBoxBackgroundBrush}"
                            CornerRadius="8"
                            Padding="10"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="8" ShadowDepth="2" />
                        </Border.Effect>
                        <TextBox Background="Wheat" x:Name="NameTb" FontSize="16" BorderThickness="0" />
                    </Border>
                    <TextBlock x:Name="ErrorTb"
                               Style="{StaticResource ErrorTextBlock}"
                               Padding="0 10 0 5"
                               Text="THIS IS AN ERROR!!!"
                               Foreground="Red" />


                    <CheckBox x:Name="SetAsDefaultPetCb" Margin="10"
                              HorizontalAlignment="Center"
                              IsChecked="True"
                              VerticalAlignment="Center">
                        Set as Default Pet
                    </CheckBox>

                    <Button Content="Let's pet!"
                            Style="{StaticResource AccentButtonAqua}"
                            Background="Aqua" Foreground="DarkBlue"
                            IsDefault="True"
                            Click="OKButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</engine:Window>