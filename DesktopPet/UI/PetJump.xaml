<desktopPet:TickingWindow x:Class="DesktopPet.UI.PetJump"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopPet.UI"
        xmlns:desktopPet="clr-namespace:DesktopPet"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowState="Normal"
        Topmost="True"
        Title="PetJump" Height="450" Width="800">
    <desktopPet:TickingWindow.Background>
        <SolidColorBrush Color="AliceBlue" Opacity="0.002"/>
    </desktopPet:TickingWindow.Background>
    <Canvas x:Name="gameCanvas" Background="Transparent"/>
</desktopPet:TickingWindow>
